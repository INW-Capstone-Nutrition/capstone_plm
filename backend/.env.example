PLM_DATABASE_URL=sqlite:///./plm_dev.db
PLM_CORS_ORIGINS=http://localhost:5173
PLM_SEED_DEMO_DATA=true
PLM_AUTO_CREATE_SCHEMA=false
PLM_CHECK_DATABASE_ON_STARTUP=true

# Recommended SQL Server configuration. Separate fields allow a raw quoted password
# without URL encoding. Remove/comment PLM_DATABASE_URL when using these fields.
# PLM_DB_HOST=10.245.25.50
# PLM_DB_PORT=1433
# PLM_DB_NAME=PLM_DEV
# PLM_DB_USER=webappsvc
# PLM_DB_PASSWORD="replace with the raw password"
# PLM_DB_DRIVER=ODBC Driver 18 for SQL Server
# PLM_DB_ENCRYPT=yes
# PLM_DB_TRUST_SERVER_CERTIFICATE=yes
# PLM_AUTO_CREATE_SCHEMA=false

# Single-URL alternative (the password must be URL encoded):
# PLM_DATABASE_URL=mssql+pyodbc://user:password@server/PLM?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
